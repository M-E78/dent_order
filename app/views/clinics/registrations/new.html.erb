<div class="min-h-screen bg-gray-50 flex flex-col justify-center py-12 px-6">
  <div class="sm:mx-auto sm:w-full sm:max-w-md bg-white py-8 px-10 shadow rounded-xl">
    
    <h2 class="text-center text-2xl font-bold text-gray-900 mb-8">
      歯科医院 新規登録
    </h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-6" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <%# --- 歯科医院名 --- %>
      <div>
        <%= f.label :clinic_name, "歯科医院名", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :clinic_name, autofocus: true, class: "w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
      </div>

      <%# --- 氏名 --- %>
      <div>
        <%= f.label :name, "氏名（院長名）", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :name, placeholder: "歯科 太郎", class: "w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
      </div>

      <%# --- Eメール --- %>
      <div>
        <%= f.label :email, "Eメール", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.email_field :email, autocomplete: "email", class: "w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
      </div>

      <%# --- パスワード --- %>
      <div>
        <%= f.label :password, "パスワード", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <% if @minimum_password_length %>
          <em class="text-xs text-gray-500">(<%= @minimum_password_length %> 文字以上)</em>
        <% end %>
        <%= f.password_field :password, autocomplete: "new-password", class: "w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
      </div>

      <%# --- パスワード（確認用） --- %>
      <div>
        <%= f.label :password_confirmation, "パスワード（確認用）", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" %>
      </div>

      <div>
        <%= f.submit "登録する", class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-md shadow transition duration-200 cursor-pointer" %>
      </div>
    <% end %>

    <div class="mt-6 text-center">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>