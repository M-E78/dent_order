<div class="min-h-screen bg-slate-50 py-12 px-4">
  <div class="max-w-2xl mx-auto">
    <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200">
      
      <%# ヘッダー部分 %>
      <div class="border-b border-slate-100 pb-6 mb-8">
        <h1 class="text-2xl font-bold text-slate-800">技工指示書の新規作成</h1>
        <p class="text-slate-500 mt-2">患者：<%= @patient.name %> 様（カルテNo: <%= @patient.chart_number %>）</p>
      </div>

      <%= form_with model: [@patient, @lab_order], local: true, class: "space-y-6" do |f| %>
        
        <%# 担当医とセット日（横並び） %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <%= f.label :doctor_name, "担当Dr", class: "block text-sm font-semibold text-slate-700 mb-1" %>
            <%= f.text_field :doctor_name, class: "w-full rounded-lg border-slate-300 focus:ring-blue-500 focus:border-blue-500" %>
          </div>
          <div>
            <%= f.label :set_date, "セット日（納期）", class: "block text-sm font-semibold text-slate-700 mb-1" %>
            <%= f.date_field :set_date, class: "w-full rounded-lg border-slate-300 focus:ring-blue-500 focus:border-blue-500" %>
          </div>
        </div>

        <%# 製作物とマテリアル（横並び） %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <%= f.label :menu_name, "製作物（PFM/ジルコニア等）", class: "block text-sm font-semibold text-slate-700 mb-1" %>
            <%= f.text_field :menu_name, placeholder: "例：ジルコニアインレー", class: "w-full rounded-lg border-slate-300 focus:ring-blue-500 focus:border-blue-500" %>
          </div>
          <div>
            <%= f.label :material, "マテリアル", class: "block text-sm font-semibold text-slate-700 mb-1" %>
            <%= f.text_field :material, placeholder: "例：マルチレイヤー", class: "w-full rounded-lg border-slate-300 focus:ring-blue-500 focus:border-blue-500" %>
          </div>
        </div>

        <%# シェード %>
        <div>
          <%= f.label :shade, "シェード（歯の色）", class: "block text-sm font-semibold text-slate-700 mb-1" %>
          <%= f.text_field :shade, placeholder: "例：A2", class: "w-full rounded-lg border-slate-300 focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <%# 特記事項 %>
        <div>
          <%= f.label :notes, "特記事項・自由記載欄", class: "block text-sm font-semibold text-slate-700 mb-1" %>
          <%= f.text_area :notes, rows: 4, placeholder: "技工士さんへの指示を記入してください", class: "w-full rounded-lg border-slate-300 focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <%# 送信ボタン %>
        <div class="pt-6 flex items-center justify-between border-t border-slate-100">
          <%= link_to "キャンセル", root_path, class: "text-slate-500 hover:text-slate-700 font-medium" %>
          <%= f.submit "指示書を発行する", class: "bg-blue-600 text-white px-8 py-3 rounded-xl font-bold shadow-lg shadow-blue-200 hover:bg-blue-700 transition-all cursor-pointer" %>
        </div>
      <% end %>

    </div>
  </div>
</div>