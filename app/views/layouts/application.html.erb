<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Dent-Order" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>

    <meta property="og:title" content="Dent-Order | 歯科業界向け受発注システム">
    <meta property="og:description" content="歯科医院と歯科技工所をつなぐ、スムーズな受発注管理システムです。">
    <meta property="og:image" content="<%= asset_url('ogp.png') %>">
    <meta name="twitter:card" content="summary_large_image">
  </head>

  <body class="bg-slate-50">
    <%# 1. ログイン時のみヘッダーを表示 %>
    <%= render 'shared/header' if user_signed_in? %>

    <%# 2. 通知メッセージ %>
    <% if notice %>
      <div class="bg-blue-50 border-b border-blue-200 text-blue-700 px-4 py-3 text-sm text-center">
        <%= notice %>
      </div>
    <% end %>
    
    <%# 3. メインコンテンツ %>
    <main>
      <%= yield %>
    </main>
  </body>

</html>
