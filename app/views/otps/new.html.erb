<div class="min-h-screen flex items-center justify-center bg-slate-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8 bg-white p-10 rounded-2xl shadow-xl border border-slate-100">
    <div class="text-center">
      <div class="inline-flex items-center justify-center w-16 h-16 bg-blue-100 rounded-full mb-4">
        <span class="text-3xl">🛡️</span>
      </div>
      <h2 class="text-3xl font-extrabold text-slate-900">二段階認証</h2>
      <p class="mt-2 text-sm text-slate-600">
        認証アプリを開き、表示されている6桁のコードを入力してください。
      </p>
    </div>

    <%= form_with url: user_otp_path, method: :post, local: true, class: "mt-8 space-y-6" do |f| %>
      <div class="rounded-md shadow-sm">
        <%= f.text_field :otp_attempt, 
            autofocus: true, 
            inputmode: "numeric", 
            pattern: "[0-9]*", 
            autocomplete: "one-time-code", 
            placeholder: "000000",
            class: "appearance-none relative block w-full px-3 py-4 border border-slate-300 placeholder-slate-400 text-slate-900 rounded-lg focus:outline-none focus:ring-blue-500 focus:border-blue-500 focus:z-10 text-3xl text-center tracking-[0.5em] font-mono" %>
      </div>

      <div>
        <%= f.submit "認証する", class: "group relative w-full flex justify-center py-3 px-4 border border-transparent text-lg font-bold rounded-xl text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-all shadow-lg shadow-blue-200" %>
      </div>
    <% end %>

    <div class="text-center mt-4">
      <%= link_to "ログイン画面に戻る", new_user_session_path, class: "text-sm text-slate-500 hover:text-slate-700 underline" %>
    </div>
  </div>
</div>