<div class="min-h-screen flex items-center justify-center bg-slate-50 px-4">
  <div class="max-w-md w-full space-y-8 bg-white p-10 rounded-2xl shadow-xl">
    <div class="text-center">
      <h2 class="text-2xl font-bold text-slate-800">新規アカウント登録</h2>
      <p class="mt-2 text-sm text-slate-500">登録タイプを選択</p>
    </div>

    <div class="mt-8 space-y-4">
      <%# 歯科医院用：今のテストページへ %>
      <%= link_to new_user_registration_path, class: "flex items-center p-4 border-2 border-blue-100 rounded-xl hover:bg-blue-50 transition-all group" do %>
        <div class="bg-blue-100 p-3 rounded-lg group-hover:bg-blue-200 transition-colors">
          <svg class="h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
        </div>
        <div class="ml-4 text-left">
          <p class="text-base font-bold text-slate-700">歯科医院として登録</p>
          <p class="text-xs text-slate-400">指示書を作成する歯科医師の方はこちら</p>
        </div>
      <% end %>

      <%# 歯科技工所用：準備中 %>
      <%= link_to "#", class: "flex items-center p-4 border-2 border-slate-100 rounded-xl bg-slate-50 cursor-not-allowed opacity-60" do %>
        <div class="bg-slate-200 p-3 rounded-lg text-slate-400">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" /></svg>
        </div>
        <div class="ml-4 text-left">
          <p class="text-base font-bold text-slate-400">歯科技工所として登録 [準備中]</p>
          <p class="text-xs text-slate-400">指示書を受注する歯科技工士の方はこちら</p>
        </div>
      <% end %>
    </div>

    <div class="text-center pt-4">
      <%= link_to "ログイン画面に戻る", root_path, class: "text-sm font-medium text-blue-600 hover:text-blue-500" %>
    </div>
  </div>
</div>