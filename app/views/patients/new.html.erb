<div class="min-h-screen bg-slate-50 py-12 px-4">
  <div class="max-w-md mx-auto">
    <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200">
      <h1 class="text-2xl font-bold text-slate-800 mb-6">新規患者登録</h1>

      <%= form_with model: @patient, local: true, class: "space-y-4" do |f| %>
        <div>
          <%= f.label :chart_number, "カルテ番号", class: "block text-sm font-medium text-slate-700" %>
          <%= f.text_field :chart_number, class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm" %>
        </div>
        <div>
          <%= f.label :name, "患者氏名", class: "block text-sm font-medium text-slate-700" %>
          <%= f.text_field :name, placeholder: "例：山田 太郎", class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm" %>
        </div>
        <%# 他の項目（カナなど）は一旦省略して爆速登録！ %>
        <div class="pt-4">
          <%= f.submit "保存して指示書作成へ", class: "w-full bg-blue-600 text-white py-3 rounded-xl font-bold hover:bg-blue-700 cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>
</div>