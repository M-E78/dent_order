<div class="min-h-screen bg-slate-50 py-8 px-4">
  <div class="max-w-4xl mx-auto">
    
    <%# --- 患者基本情報ヘッダー --- %>
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 mb-6 flex justify-between items-end">
      <div>
        <p class="text-sm text-slate-500 mb-1">カルテNo: <%= @patient.chart_number %></p>
        <h1 class="text-3xl font-bold text-slate-800"><%= @patient.name %> 様</h1>
      </div>
      <%= link_to "新しい指示書を作成", new_patient_lab_order_path(@patient), class: "bg-blue-600 text-white px-4 py-2 rounded-lg font-bold hover:bg-blue-700 transition" %>
    </div>

    <h2 class="text-xl font-bold text-slate-800 mb-4 ml-2 text-left">指示書履歴</h2>

    <%# --- 指示書のリスト --- %>
    <% if @lab_orders.any? %>
      <div class="space-y-4">
        <% @lab_orders.each do |order| %>
          <div class="bg-white p-6 rounded-xl border border-slate-100 shadow-sm mb-6">
            
            <%# 1. ヘッダー部分：発行日とセット日を左側に統一して配置 %>
            <div class="flex justify-start items-start gap-12 mb-6 pb-4 border-b border-slate-50">
              <%# 発行日 %>
              <div>
                <p class="text-xs text-slate-400 font-bold mb-1">発行日</p>
                <p class="text-lg font-bold text-blue-600">
                  <%= order.order_date || order.created_at.strftime("%Y/%m/%d") %>
                </p>
              </div>

              <%# セット日（フォントサイズを発行日と統一） %>
              <div>
                <p class="text-xs text-slate-400 font-bold mb-1">セット日</p>
                <p class="text-lg font-bold text-blue-600">
                  <%= order.set_date || "---" %>
                </p>
              </div>
            </div>

            <%# 2. メイングリッド（担当医、製作物など） %>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-sm mb-2">
              <div>
                <p class="text-xs text-slate-400 mb-1">担当医</p>
                <p class="font-bold text-slate-700"><%= order.user&.name || "---" %></p>
              </div>
              <div>
                <p class="text-xs text-slate-400 mb-1">製作物</p>
                <p class="font-bold text-slate-800">
                  <%= order.prosthesis_types&.reject(&:blank?)&.join(", ") || "未入力" %>
                </p>
              </div>
              <div>
                <p class="text-xs text-slate-400 mb-1">メタル</p>
                <p class="font-bold text-slate-700"><%= order.material || order.metal_type || "指定なし" %></p>
              </div>
              <div>
                <p class="text-xs text-slate-400 mb-1">シェード</p>
                <p class="font-bold text-slate-700"><%= order.shade || "指定なし" %></p>
              </div>
            </div>

            <%# 3. 備考欄（存在する場合のみ） %>
            <% if order.treatment_details.present? %>
              <div class="mt-4 p-3 bg-slate-50 rounded-lg">
                <p class="text-xs text-slate-400 mb-1">備考</p>
                <p class="text-sm text-slate-600"><%= order.treatment_details %></p>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-12 bg-white rounded-xl border border-dashed border-slate-300">
        <p class="text-slate-400">まだ指示書の履歴はありません</p>
      </div>
    <% end %>

    <div class="mt-8 text-center">
      <%= link_to "一覧に戻る", root_path, class: "text-slate-500 hover:underline" %>
    </div>
  </div>
</div>