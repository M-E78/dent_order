<div class="max-w-md mx-auto py-12 px-4">
  <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200">
    <h2 class="text-2xl font-bold text-slate-800 mb-6 text-center">セキュリティ設定</h2>

    <% if current_user.otp_required_for_login %>
      <div class="bg-green-50 border border-green-200 text-green-700 p-4 rounded-xl mb-6 flex items-center justify-center">
        <span class="mr-2">🛡️</span> 二段階認証は現在「有効」です
      </div>
      <div class="text-center">
        <%= button_to "二段階認証を解除する", profiles_two_factor_auth_path, method: :delete, class: "text-sm text-red-500 hover:text-red-700 underline" %>
      </div>
    <% else %>
      <p class="text-slate-600 mb-6 text-sm text-center">
        認証アプリでQRコードをスキャンし、表示された6桁の数字を入力してください。
      </p>

      <div class="flex justify-center mb-8 bg-slate-50 p-4 rounded-xl border border-dashed border-slate-300">
        <%= @qrcode.html_safe %>
      </div>

      <%= form_with url: profiles_two_factor_auth_path, method: :post, local: true, class: "space-y-4" do |f| %>
        <div>
          <%= f.label :otp_attempt, "認証コード（6桁）", class: "block text-sm font-bold text-slate-700 mb-1" %>
          <%= f.text_field :otp_attempt, 
              autofocus: true, 
              inputmode: "numeric", 
              pattern: "[0-9]*", 
              autocomplete: "one-time-code", 
              placeholder: "123456",
              class: "block w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none text-center text-2xl tracking-widest" %>
        </div>

        <%= f.submit "認証して有効化する", class: "w-full bg-blue-600 text-white font-bold py-3 px-4 rounded-xl hover:bg-blue-700 transition-all shadow-lg shadow-blue-100" %>
      <% end %>
    <% end %>
  </div>
</div>