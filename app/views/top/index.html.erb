<div class="min-h-screen bg-slate-50 py-8 px-4">
  <div class="max-w-7xl mx-auto">
    
    <% if user_signed_in? %>
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
        <h1 class="text-2xl font-bold text-slate-800">
          ようこそ、<%= current_user.name || "ゲスト" %> 先生
        </h1>
        <div class="mt-4">
          <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "text-sm text-slate-500 hover:text-red-600 underline" %>
        </div>
        <p class="text-slate-500 mt-2">
          現在のステータス：<%= current_user.clinic.present? ? "歯科医院" : "歯科技工所" %> モード
        </p>
      </div>

      <%# --- メインコンテンツ（患者一覧） --- %>
  <div class="flex justify-between items-center mb-6">
    <h2 class="text-xl font-bold text-gray-800">患者一覧</h2>
    <%= link_to '新規患者登録', new_patient_path, class: "bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition" %>
  </div>

  <% if @patients.any? %>
    <div class="bg-white shadow-md rounded-xl overflow-hidden border border-gray-200">
      <table class="min-w-full leading-normal">
        <%# 項目名 %>
        <thead class="bg-slate-50 text-slate-500 text-xs uppercase font-bold">
          <tr>
            <th class="px-4 py-3 text-left">カルテNo</th>
            <th class="px-4 py-3 text-left">氏名</th>
            <th class="px-4 py-3 text-left">製作物</th>
            <th class="px-4 py-3 text-left">セット日</th>
            <th class="px-4 py-3 text-left">ステータス</th>
            <th class="px-4 py-3 text-center">詳細</th>
            <th class="px-5 py-3 border-b border-gray-200"></th>
          </tr>
        </thead>

        <%# 中身 %>
        <tbody class="divide-y divide-slate-100 text-sm">
          <% @patients.each do |patient| %>
            <tr class="hover:bg-blue-50/50 transition">
              <td class="px-4 py-4"><%= patient.chart_number %></td>
              <td class="px-4 py-4 font-bold text-slate-800"><%= patient.name %></td>
              
              <%# 最新の指示書を取得 %>
              <% last_order = patient.lab_orders.last %>
              <td class="px-4 py-4 text-slate-600">
                <%= last_order&.menu_name || "---" %>
              </td>
              <td class="px-4 py-4 text-blue-600 font-bold">
                <%= last_order&.set_date || "---" %>
              </td>
              <td class="px-4 py-4">
                <% if last_order %>
                  <span class="px-2 py-1 rounded text-xs font-bold <%= last_order.pending? ? 'bg-slate-100 text-slate-500' : 'bg-green-100 text-green-700' %>">
                    <%= last_order.status_text %>
                  </span>
                <% else %>
                  <span class="text-slate-300 text-xs">指示書なし</span>
                <% end %>
              </td>
              <td class="px-4 py-4 text-center">
                <%= link_to "詳細", patient_path(patient), class: "text-blue-600 hover:text-blue-800 font-bold" %>
              </td>
            </tr>
          <% end %>
        </tbody>

      </table>
    </div>
  <% else %>
    <%# まだ患者がいない時の表示 %>
    <div class="text-center py-20 bg-white rounded-xl border-2 border-dashed border-gray-300">
      <p class="text-gray-500 mb-4">登録されている患者さんはまだいません</p>
      <%= link_to '最初の患者さんを登録する', new_patient_path, class: "text-blue-600 font-bold hover:underline" %>
    </div>
  <% end %>
</div>

    <% else %>
      <%# 万が一ログインせずにここに来た時のための念のため（基本はリダイレクトされます） %>
      <%= link_to "ログインしてください", new_user_session_path, class: "text-blue-600 underline" %>
    <% end %>

  </div>
</div>