<div class="min-h-screen bg-slate-50 py-8 px-4">
  <%# 🛡️ 二段階認証警告バナー %>
  <% if user_signed_in? && !current_user.otp_required_for_login %>
    <div class="bg-amber-50 border-l-4 border-amber-500 p-4 mb-6 rounded-r-md shadow-sm">
      <div class="flex items-start">
        <div class="flex-shrink-0"><span class="text-amber-500 text-xl">⚠️</span></div>
        <div class="ml-3 flex-1 md:flex md:justify-between items-center">
          <p class="text-sm text-amber-800 font-medium">セキュリティ向上のため、二段階認証（2FA）の設定をお願いします。</p>
          <p class="mt-3 text-sm md:mt-0 md:ml-6">
            <%= link_to "設定画面へ", two_factor_auth_path, class: "whitespace-nowrap font-bold text-amber-700 hover:text-amber-600 underline" %>
          </p>
        </div>
      </div>
    </div>
  <% end %>

  <div class="max-w-7xl mx-auto">
    <% if user_signed_in? %>
      <%# ユーザー情報カード %>
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 mb-8">
        <div class="flex justify-between items-center">
          <div>
            <h1 class="text-2xl font-bold text-slate-800">ようこそ、<%= current_user.name || "ゲスト" %> 先生</h1>
            <p class="text-slate-500 mt-2">
              現在のステータス：<%= current_user.clinic.present? ? "歯科医院" : "歯科技工所" %> モード
            </p>
          </div>
        </div>
      </div>

      <%# 患者一覧見出し %>
      <div class="flex justify-between items-center mb-6">
        <h2 class="text-xl font-bold text-gray-800">患者一覧</h2>
        <%= link_to '新規患者登録', new_patient_path, class: "bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 shadow-md transition" %>
      </div>

      <% if @patients.any? %>
        <div class="bg-white shadow-md rounded-xl overflow-hidden border border-gray-200">
          <table class="min-w-full leading-normal">
            <thead class="bg-slate-50 text-slate-500 text-xs uppercase font-bold border-b border-slate-200">
              <tr>
                <th class="px-4 py-3 text-left">担当Dr</th>
                <th class="px-4 py-3 text-left">カルテNo</th>
                <th class="px-4 py-3 text-left">発行日</th>
                <th class="px-4 py-3 text-left">氏名</th>
                <th class="px-4 py-3 text-left">製作物</th>
                <th class="px-4 py-3 text-left">セット日</th>
                <th class="px-4 py-3 text-center">操作</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-sm">
              <% @patients.each do |patient| %>
                <% last_order = patient.lab_orders.last %>
                <tr class="hover:bg-blue-50/50 transition">
                  <%# 1. 担当ドクター %>
                  <td class="px-4 py-4 text-slate-600">
                    <%= last_order&.user&.name || "---" %>
                  </td>
                  <%# 2. カルテNo %>
                  <td class="px-4 py-4 text-slate-500"><%= patient.chart_number %></td>
                  <%# 3. 発行日 %>
                  <td class="px-4 py-4 text-slate-500">
                    <%= last_order&.try(:order_date)&.strftime("%Y/%m/%d") || last_order&.created_at&.strftime("%Y/%m/%d") || "---" %>
                  </td>
                  <%# 4. 氏名 %>
                  <td class="px-4 py-4 font-bold text-slate-800"><%= patient.name %></td>
                  <%# 5. 製作物 %>
                  <td class="px-4 py-4 text-slate-600">
                    <% if last_order %>
                      <% if last_order.prosthesis_types.present? %>
                        <%# 🌟 部位（tooth_numbers）の表示を削除しました %>
                        <%= last_order.prosthesis_types.reject(&:blank?).join(", ") %>
                      <% else %>
                        <span class="text-slate-400 italic">（内容未入力）</span>
                      <% end %>
                    <% else %>
                      <span class="text-slate-300">指示書なし</span>
                    <% end %>
                  </td>
                  <%# 6. セット日 %>
                  <td class="px-4 py-4 text-slate-600 font-bold">
                    <%= last_order&.set_date || "---" %>
                  </td>
                  <%# 7. 操作 %>
                  <td class="px-4 py-4 text-center">
                    <div class="flex items-center justify-center gap-2">
                      <%= link_to "詳細", patient_path(patient), class: "text-blue-600 hover:text-blue-800 font-bold px-3 py-1 bg-blue-50 rounded-lg transition" %>
                      <%= button_to "削除", patient_path(patient), method: :delete, data: { turbo_confirm: "本当に削除しますか？" }, class: "text-red-500 hover:text-red-700 font-bold px-3 py-1 bg-red-50 rounded-lg transition" %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-20 bg-white rounded-xl border-2 border-dashed border-gray-300">
          <p class="text-gray-500 mb-4">登録されている患者さんはまだいません</p>
          <%= link_to '最初の患者さんを登録する', new_patient_path, class: "text-blue-600 font-bold hover:underline" %>
        </div>
      <% end %>
    <% else %>
      <div class="text-center py-20">
        <%= link_to "ログインしてください", new_user_session_path, class: "text-blue-600 text-xl font-bold underline" %>
      </div>
    <% end %>
  </div>
</div>